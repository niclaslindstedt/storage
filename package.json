{
  "name": "storage-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, end-to-end encrypted storage backend for local-first PWAs.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "workspaces": [
    "packages/server",
    "packages/cli",
    "packages/testkit",
    "packages/mcp",
    "e2e",
    "apps/reference",
    "apps/remote",
    "apps/drive"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
