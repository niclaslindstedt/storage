#!/usr/bin/env bash
# Conventional-commit subject lint. Install with `make hooks`.
set -euo pipefail

subject=$(head -n1 "$1")
case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._/-]+\))?!?: .+'
if ! grep -qE "$pattern" <<<"$subject"; then
  echo "commit-msg: subject must follow Conventional Commits, e.g." >&2
  echo "  feat(server): add namespace quotas" >&2
  echo "got: ${subject}" >&2
  exit 1
fi
if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: subject is ${#subject} chars; keep it under 100" >&2
  exit 1
fi
