{
  "name": "@niclaslindstedt/storage-testkit",
  "version": "0.1.0",
  "description": "Run a real storage-server in your tests: in-process for Vitest, as a process for Playwright — with seeding, snapshots, fault injection and clock control.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niclaslindstedt/storage.git",
    "directory": "packages/testkit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@niclaslindstedt/storage-server": "0.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@niclaslindstedt/oss-framework": ">=3.11.0"
  },
  "peerDependenciesMeta": {
    "@niclaslindstedt/oss-framework": {
      "optional": true
    }
  }
}
