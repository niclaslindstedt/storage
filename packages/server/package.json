{
  "name": "@niclaslindstedt/storage-server",
  "version": "0.1.2",
  "description": "Self-hosted, zero-knowledge storage server for local-first PWAs: end-to-end encrypted files and rows, QR pairing, per-namespace sharing, ACME certificates and UPnP.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Niclas Lindstedt <niclas@agilator.se>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niclaslindstedt/storage.git",
    "directory": "packages/server"
  },
  "bin": {
    "storage-server": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "man",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "gen:man": "node --experimental-strip-types --no-warnings scripts/gen-man.ts",
    "test:browser": "playwright test"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "^0.27.0"
  }
}
